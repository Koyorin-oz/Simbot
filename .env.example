# Token du bot (Developer Portal > Bot)
DISCORD_TOKEN=

# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=

# ID du serveur Discord (deploy des commandes, channelSetup.json, etc.). Défaut = La Carminauté (prod).
DISCORD_GUILD_ID=735584468420657292

# Optionnel : meme role que DISCORD_GUILD_ID si tu preferes ce nom (sinon laisse vide)
# GUILD_ID=

DATABASE_URL="file:./dev.db"

ECONOMY_LOG_CHANNEL_ID=
# Annonces niveau / rang : **uniquement** ce salon (défaut 1488214951867842652). Pas d’autre salon.
# ECONOMY_MILESTONE_CHANNEL_ID=1488214951867842652

# Rôles slash (controle SimBot a l’execution) : dev+admin vs modération. Discord ne laisse plus les bots regler la visibilite des slashs par API — regle l’affichage dans Integrations > SimBot > Commandes si besoin.
# COMMAND_ADMIN_DEV_ROLE_ID=739948639300092055
# COMMAND_MODERATION_ROLE_ID=736488084929118298
# Alias : COMMAND_STAFF_ROLE_ID (si COMMAND_MODERATION_ROLE_ID est vide)
# COMMAND_OWNER_USER_ID=965984018216665099
# COMMAND_STAFF_PERMISSION_BIT=32

# Logs terminal : 1 = afficher aussi le détail (Groq, chaîne de modèles, etc.)
# BOT_VERBOSE_LOGS=1

# --- Groq + Meta Llama 3 (gratuit — /dinguerie + ping IA) ---
# Ce n’est PAS « Grok » (xAI). Clé Groq : https://console.groq.com/keys (préfixe gsk_)
GROQ_API_KEY=
# Llama 3.x hébergé par Groq : llama-3.1-8b-instant, llama-3.3-70b-versatile — https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant
# GROQ_API_BASE=https://api.groq.com/openai/v1
# GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile
# Délai entre deux requêtes IA (ms). Alias : GROK_COOLDOWN_MS, GEMINI_COOLDOWN_MS. Sans variable : 8 000.
GROQ_COOLDOWN_MS=8000
# 1 = injecter dans le prompt la liste des emojis custom du serveur (pour que l’IA les recopie). 0 = désactiver.
# GROQ_GUILD_EMOJIS_IN_PROMPT=1
# Nombre max d’emojis listés (défaut 80, plafond 200).
# GROQ_GUILD_EMOJI_MAX=80
# GROQ_TEMPERATURE=1.05
# GROQ_MAX_TOKENS=380
# GROQ_SYSTEM_PROMPT=
# Fichier par défaut si pas de prompt inline : colle ton prompt ici (sans /ia-prompt)
# GROQ_SYSTEM_PROMPT_FILE=src/data/groqSystemPrompt.txt

# IDs « propriétaire IA » (en plus des admins Discord). Séparateur virgule.
# IA_OWNER_USER_IDS=965984018216665099

# Ping IA : salon public (tout le monde) ; salon staff (rôle ci-dessous, sans cooldown) ; admins = tout salon
# GROQ_PING_CHANNEL_ID=1488156790066778132
# GROQ_PING_STAFF_CHANNEL_ID=735985783843979386
# GROQ_PING_ROLE_ELSEWHERE=740999121812586567
# Alias historique : GEMINI_PING_CHANNEL_ID, GEMINI_PING_STAFF_CHANNEL_ID, GEMINI_PING_ROLE_ELSEWHERE
# GROQ_PING_MAX_TOKENS=640
