# Copie en .env (racine du projet) et remplis les valeurs.
# .env n'est jamais dans Git : si tu le perds, recupere les secrets sur Pebble (File Manager → .env)
# ou regenere-les (Discord : reset token ; Groq : console groq.com → API keys).

# --- Discord (obligatoire) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel : sinon config.js utilise le serveur principal code en dur
GUILD_ID=
# Alias accepte par deploy-commands / certains scripts
# DISCORD_GUILD_ID=

# Image de fond du canvas de bienvenue (chemin absolu sur le serveur). Optionnel si tu utilises
# assets/welcome-canvas-background.png dans le repo (recommandé avec git push → Pebble).
# WELCOME_CANVAS_BACKGROUND=/home/container/assets/welcome-canvas-background.png

# --- Base SQLite (Prisma) ---
# Chemin relatif au dossier prisma/ (schema.prisma). Ici = fichier prisma/dev.db
DATABASE_URL="file:./dev.db"

# --- IA SimBot (ping, dinguerie) ---
# Ordre : Gemini → Groq gpt-oss → Groq repli (qwen / autre gpt-oss)
# IA_PROVIDER_ORDER=gemini,groq-gpt,groq-llama
# Si ton .env a encore gemini,openai,groq : le code remplace openai par groq-gpt automatiquement.

# Google Gemini (principal) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview
# GEMINI_TEMPERATURE=
# GEMINI_MAX_TOKENS=
# GEMINI_PING_MAX_TOKENS=768
# IA_PING_MIN_OUTPUT_TOKENS=512
# IA_MODEL_DISCLOSURE_USER_ID=1278372257483456603

# Groq — https://console.groq.com/keys (gsk_…, PAS Grok/xAI)
# IMPORTANT (août 2026) : llama-3.3-70b-versatile / llama-3.1-8b-instant ont été retirés.
# Utilise openai/gpt-oss-20b, openai/gpt-oss-120b ou qwen/qwen3.6-27b (remap auto si anciens IDs).
GROQ_API_KEY=
GROQ_GPT_MODEL=openai/gpt-oss-20b
GROQ_GPT_MODEL_FALLBACKS=openai/gpt-oss-120b,qwen/qwen3.6-27b
# Repli 3 (nom legacy groq-llama) :
GROQ_LLAMA_MODEL=openai/gpt-oss-120b
GROQ_LLAMA_MODEL_FALLBACKS=qwen/qwen3.6-27b,openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b
# GROK_API_KEY=
# GROQ_API_BASE=https://api.groq.com/openai/v1
# Chain-of-thought (Groq) : openai/gpt-oss-* — effort low|medium|high ; 1 = exposer le champ reasoning (debug)
# GROQ_REASONING_EFFORT=medium
# GROQ_INCLUDE_REASONING=
# qwen/qwen3* : none|default + parsed|raw|hidden
# GROQ_QWEN_REASONING_EFFORT=default
# GROQ_QWEN_REASONING_FORMAT=hidden
# GROQ_SYSTEM_PROMPT=
# GROQ_SYSTEM_PROMPT_FILE=
# GROQ_TEMPERATURE=
# GROQ_MAX_TOKENS=
# Ton ping IA : préfère /ia-mode (stocké en base). Si mode auto : GROQ_PING_TONE peut encore forcer hard/soft
# GROQ_PING_TONE=auto
# GROQ_PING_MAX_TOKENS=
# GROQ_GUILD_EMOJIS_IN_PROMPT=0
# GROQ_GUILD_EMOJI_MAX=
# GROQ_COOLDOWN_MS=
# Canaux / role ping IA (sinon defauts dans geminiAccessService.js)
# GROQ_PING_CHANNEL_ID=
# GROQ_PING_STAFF_CHANNEL_ID=
# GROQ_PING_ROLE_ELSEWHERE=
# Alias historiques GEMINI_* encore lus par geminiService.js (optionnel)

# --- Economie / logs ---
# ECONOMY_LOG_CHANNEL_ID=
# ECONOMY_MILESTONE_CHANNEL_ID=

# --- Blagues planifiees ---
# ID du salon texte (obligatoire en prod si tu ne veux pas le defaut du code)
# JOKE_CHANNEL_ID=
# JOKE_SEND_HOURS=

# --- Staff / commandes / tickets / suggestions ---
# SUGGESTIONS_STAFF_ROLE_ID=
# TICKETS_STAFF_ROLE_ID=
# IA_OWNER_USER_IDS=
# COMMAND_ADMIN_DEV_ROLE_ID=
# COMMAND_MODERATION_ROLE_ID=
# Liste exclusive (virgules) — remplace les 2 roles par defaut dans le code :
# COMMAND_MODERATION_ROLE_IDS=
# COMMAND_STAFF_ROLE_ID=
# COMMAND_OWNER_USER_ID=
# Liste exclusive (virgules) — remplace les IDs par defaut dans le code :
# COMMAND_OWNER_USER_IDS=
# COMMAND_STAFF_PERMISSION_BIT=
# STAFF_ROLE_ID=
# LOCK_CHANNEL_STAFF_ROLE_ID=
# (Sanctions : hiérarchie = ordre des rôles Discord uniquement ; plus de liste staff dans le code.)

# Liens : plusieurs rôles bypass (virgules). Un seul rôle : LINK_BYPASS_ROLE_ID=...
# LINK_BYPASS_ROLE_IDS=
# LINK_BYPASS_ROLE_ID=
# Salon autorisé pour YouTube / TikTok / Instagram (défaut dans config.js)
# LINK_MEDIA_CHANNEL_ID=

# Réordonne les rôles de rang entre les deux ancres Discord (ancien comportement). Par défaut désactivé
# pour ne pas écraser l’ordre manuel des rôles à chaque gain de rang.
# RANK_ROLES_AUTO_REORDER=1

# --- Debug ---
# BOT_VERBOSE_LOGS=1
