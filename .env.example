# Copie ce fichier en .env a la racine du bot (meme dossier que package.json).
# Ne commite jamais .env avec de vrais secrets.

DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Serveur pour lequel deployer les slash (npm run deploy:commands) et config par defaut
GUILD_ID=

# SQLite : laisse cette ligne sauf si tu utilises une autre base
DATABASE_URL="file:./prisma/dev.db"
