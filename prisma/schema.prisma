generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  guildId         String
  simbaCoins      Int      @default(0)
  simbaPoints     Int      @default(0)
  levelPoints     Int      @default(0)
  level           Int      @default(1)
  rankKey         String   @default("hyene_1")
  crownOwned      Boolean  @default(false)
  piggyOwned      Boolean  @default(false)
  coffeeUntil     DateTime?
  coffeeBoostPct  Int      @default(0)
  customRoleUnlocked Boolean @default(false)
  customRoleId     String?
  /** Derniere activite comptee (message / vocal) pour la decroissance SP. */
  lastActivityAt   DateTime @default(now())
  /** Derniere application de perte SP inactivite (un tick max par fenetre). */
  lastSpDecayAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

}

model RewardClaim {
  id         Int      @id @default(autoincrement())
  userId     String
  guildId    String
  dailyAt    DateTime?
  weeklyAt   DateTime?
  monthlyAt  DateTime?
  updatedAt  DateTime @updatedAt

  @@unique([userId, guildId])
}

model Punishment {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  type        String
  reason      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

}

model Birthday {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  day       Int
  month     Int
  year      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
}

model PrivateRoomPrefs {
  id           Int      @id @default(autoincrement())
  guildId      String
  userId       String
  defaultName  String   @default("Salon vocal")
  defaultLimit Int      @default(99)
  defaultMode  String   @default("open")
  blacklistIds String   @default("[]")
  whitelistIds String   @default("[]")
  /** Playlists Spotify publiques enregistrees (une URL par ligne, max 10) — panneau musique « Playlist Spotify ». */
  musicSpotifyUrl String @default("")
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
}

/** Morceaux ajoutes a la file (historique perso par serveur pour /music). */
model MusicPlayHistory {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  title     String
  url       String
  source    String   @default("youtube")
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
}

/** Playlist perso enregistree par membre / serveur (panneau musique). */
model MusicPlaylistItem {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  title     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([guildId, userId, sortOrder])
}

model Ticket {
  id        Int       @id @default(autoincrement())
  guildId   String
  channelId String    @unique
  ownerId   String
  /** "general" = tickets habituels ; "welcome" = processus d'accueil / verification. */
  kind      String    @default("general")
  status    String    @default("open")
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([guildId, ownerId, status, kind])
}

enum SuggestionStatus {
  OPEN
  ACCEPTED
  REJECTED
}

/** Suggestion postee via /suggestion (message Discord Components V2). */
model Suggestion {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String?  @unique
  authorId  String
  title     String
  body      String
  imageUrl  String?
  createdAt DateTime @default(now())
  /** OPEN = votes actifs ; ACCEPTED / REJECTED = clos, compteurs figes dans snapshot*. */
  status              SuggestionStatus @default(OPEN)
  moderatedAt         DateTime?
  moderatedById       String?
  moderationReason    String?
  snapshotPour        Int?
  snapshotNeutral     Int?
  snapshotContre      Int?
  votes     SuggestionVote[]
}

/** Un vote par membre et par suggestion (1 = pour, -1 = contre). */
model SuggestionVote {
  id           Int        @id @default(autoincrement())
  suggestionId Int
  userId       String
  value        Int
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

/** Une ligne par message Discord : empêche deux instances (même DB) de répondre deux fois au ping @bot. */
model IaPingDedup {
  messageId String   @id
  guildId   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/** Derniere video connue par chaine YouTube (notif nouvelles videos). sourceKey = channelId UC... */
model YouTubeNotifyState {
  sourceKey   String   @id
  lastVideoId String?
  updatedAt   DateTime @updatedAt
}

/** Videos deja notifiees (anti-doublon persistant si RSS instable / restart bot). */
model YouTubeNotifiedVideo {
  id        Int      @id @default(autoincrement())
  sourceKey String
  videoId   String
  createdAt DateTime @default(now())

  @@unique([sourceKey, videoId])
  @@index([sourceKey, createdAt])
}

/** Une seule ligne (id=1) : presence du bot + modele d’embed pour apercu (pas le statut Discord utilisateur). */
model BotRuntimeSettings {
  id Int @id @default(1)

  presenceActivityType String @default("WATCHING")
  presenceActivityName String @default("SimBot")
  presenceStatus       String @default("online")
  presenceStreamUrl    String @default("")
  /** URL image pour la photo de profil du bot (reappliquee au demarrage). Vide = ne pas changer. */
  botAvatarUrl         String @default("")

  embedTitle           String @default("")
  embedDescription     String @default("")
  embedAuthorName      String @default("")
  embedAuthorIconUrl   String @default("")
  embedFooterText      String @default("")
  embedFooterIconUrl   String @default("")
  embedImageUrl        String @default("")
  embedThumbnailUrl    String @default("")
  embedColor           Int    @default(5793266)

  /** Ton des réponses ping IA : auto | hard | soft — réglable via /ia-mode */
  iaPingTone String @default("auto")

  updatedAt DateTime @updatedAt
}
