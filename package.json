{
  "name": "carminabot",
  "version": "1.0.0",
  "description": "Bot Discord LA CARMINAUTE - economie, moderation, profil canvas",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "start": "node node_modules/prisma/build/index.js migrate deploy && node node_modules/prisma/build/index.js generate && node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:commands": "node src/deploy-commands.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev --name init"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/client": "^6.7.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5",
    "ms": "^2.1.3",
    "prisma": "^6.7.0"
  }
}
